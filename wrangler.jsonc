{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "studyloop2",
  "compatibility_date": "2026-06-27",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "studyloop",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "send_email": [
    {
      "name": "FEEDBACK_EMAIL",
      "destination_address": "hello@studyloop.in",
      "allowed_sender_addresses": ["feedback@studyloop.in"],
    },
  ],
  "observability": {
    "enabled": true,
  },
}
