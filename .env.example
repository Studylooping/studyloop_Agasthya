# Copy this file to .env.local and fill in real values.
# Never commit .env.local. Real secrets only live in the hosting platform.

# --- Public site URL (used by metadata, OG tags, sitemap) ---
NEXT_PUBLIC_SITE_URL=https://studyloop.in

# --- Supabase (Phase 2: when DB ships) ---
# From Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose this to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic API (Phase 2: for content drafting via scripts/draft-items.ts) ---
# From console.anthropic.com. Set a hard monthly cap of $50 in the Anthropic console.
ANTHROPIC_API_KEY=

# --- Sentry (optional, Phase 1) ---
SENTRY_DSN=

# --- Drafting script (Phase 2) ---
# After founder signs up, sponsor copies their profile UUID here.
DRAFTING_AUTHOR_ID=

# --- Middleware ---
RATE_LIMIT_PER_MIN=60
