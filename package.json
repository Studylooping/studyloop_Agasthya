{
  "name": "studyloop",
  "version": "0.1.0",
  "private": true,
  "description": "Free STEM study companion with original practice, hints, feedback, and local nickname memory. studyloop.in",
  "scripts": {
    "build": "node node_modules/next/dist/bin/next build",
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "node scripts/next-dev.mjs",
    "clean": "node scripts/clean-next.mjs",
    "start": "node node_modules/next/dist/bin/next start",
    "lint": "node node_modules/next/dist/bin/next lint",
    "typecheck": "node node_modules/typescript/lib/tsc.js --noEmit",
    "feedback:audit": "node scripts/audit-mc-feedback.mjs",
    "launch:audit": "node scripts/audit-launch-readiness.mjs",
    "review:export": "node scripts/export-review-package.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy:cloudflare": "opennextjs-cloudflare deploy",
    "upload:cloudflare": "opennextjs-cloudflare upload",
    "deploy:pages": "node scripts/build-pages.mjs && wrangler pages deploy out --project-name=studyloop2",
    "deploy:feedback": "wrangler deploy --config wrangler.feedback.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.1",
    "@radix-ui/react-slot": "^1.1.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.15.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "wrangler": "^4.105.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0"
}
